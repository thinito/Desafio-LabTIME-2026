# .gitignore para projeto .NET / Visual Studio

# Build e artefatos locais
[Bb]in/
[Oo]bj/
out/
artifacts/
publish/
TestResults/
coverage/
GeneratedFiles/

# Configuração do Visual Studio / IDE
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.pidb
*.dbmdl
*.opendb
*.VC.db

# JetBrains / VS Code
.idea/
.vscode/
*.code-workspace
*.sln.iml
*.swp
*.tmp

# NuGet
packages/
.nuget/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# ASP.NET / Web
node_modules/
wwwroot/lib/
ScaffoldedFiles/

# Logs e temporários
*.log
*.tlog
*.tmp
*.bak

# Arquivos de sistema
Thumbs.db
.DS_Store
Desktop.ini

# Secrets e configs locais
secrets.json
appsettings.Secret*.json

# Simbols e arquivos de depuração
*.pdb
*.mdb
*.dll
*.exe

# Exceção: mantenha o código-fonte e a documentação do projeto no controle do Git
# (não ignorar arquivos manualmente aqui, apenas artefatos gerados e locais da máquina)
